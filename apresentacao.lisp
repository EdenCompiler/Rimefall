;;; Um único formato de vértice atende cenário, objetos, arma e letras.
(defparameter *programa-vertices*
"#version 330 core
layout(location=0) in vec3 posicao;
layout(location=1) in vec4 cor;
uniform mat4 matriz;
uniform vec3 olho;
out vec4 tonalidade;
out float distancia;
void main() {
  gl_Position = matriz * vec4(posicao, 1.0);
  tonalidade = cor;
  distancia = gl_Position.w;
}")
(defparameter *programa-fragmentos*
"#version 330 core
in vec4 tonalidade;
in float distancia;
uniform float neblina;
uniform float inicio;
uniform float fim;
out vec4 resultado;
void main() {
  float mistura = smoothstep(inicio, fim, distancia) * neblina;
  resultado = vec4(mix(tonalidade.rgb, vec3(0.47,0.56,0.61), mistura), tonalidade.a);
}")
(defstruct (malha (:constructor %criar-malha) (:predicate malha-p) (:copier copiar-malha))
  arranjo memoria (quantidade 0))
