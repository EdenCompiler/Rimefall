(defun iniciar-vertices ()
  (make-array 100000 :element-type 'single-float :adjustable t :fill-pointer 0))
(defun vertice (x y z cor)
  (dolist (valor (list x y z (first cor) (second cor) (third cor) (or (fourth cor) 1.0)))
    (vector-push-extend (float valor 1.0) *vertices*)))
(defun triangulo (primeiro segundo terceiro cor)
  (dolist (ponto (list primeiro segundo terceiro))
    (vertice (first ponto) (second ponto) (third ponto) cor)))
(defun quadrilatero (primeiro segundo terceiro quarto cor)
  (triangulo primeiro segundo terceiro cor) (triangulo primeiro terceiro quarto cor))
(defun tonalizar (cor intensidade)
  (list (* (first cor) intensidade) (* (second cor) intensidade) (* (third cor) intensidade)
        (or (fourth cor) 1.0)))
(defun caixa (x y z largura altura profundidade cor)
  (let* ((esquerda (- x (/ largura 2))) (direita (+ x (/ largura 2)))
         (baixo (- y (/ altura 2))) (cima (+ y (/ altura 2)))
         (frente (+ z (/ profundidade 2))) (fundo (- z (/ profundidade 2)))
         (pontos (vector (list esquerda baixo frente) (list direita baixo frente)
                         (list direita cima frente) (list esquerda cima frente)
                         (list esquerda baixo fundo) (list direita baixo fundo)
                         (list direita cima fundo) (list esquerda cima fundo))))
    (loop for indices in '((0 1 2 3) (5 4 7 6) (4 0 3 7) (1 5 6 2) (3 2 6 7) (4 5 1 0))
          for intensidade in '(0.80 0.64 0.70 0.91 1.12 0.50)
          do (apply #'quadrilatero
                    (append (mapcar (lambda (indice) (aref pontos indice)) indices)
                            (list (tonalizar cor intensidade)))))))
(defun retangulo (x y largura altura cor)
  (quadrilatero (list x y 0) (list (+ x largura) y 0)
                (list (+ x largura) (+ y altura) 0) (list x (+ y altura) 0) cor))
(defun moldura (x y largura altura cor)
  "Desenha uma moldura fina para painéis de briefing."
  (retangulo x y largura 2 cor)
  (retangulo x (+ y altura -2) largura 2 cor)
  (retangulo x y 2 altura cor)
  (retangulo (+ x largura -2) y 2 altura cor))

(defun criar-malha ()
  (let ((malha (%criar-malha :arranjo (lwlgl.opengl:make-vertex-array) :memoria (lwlgl.opengl:make-buffer))))
    (grafico:gl-bind-vertex-array (malha-arranjo malha))
    (grafico:gl-bind-buffer grafico:+gl-array-buffer+ (malha-memoria malha))
    (grafico:gl-vertex-attrib-pointer 0 3 grafico:+gl-float+ 0 28 (cffi:null-pointer))
    (grafico:gl-enable-vertex-attrib-array 0)
    (grafico:gl-vertex-attrib-pointer 1 4 grafico:+gl-float+ 0 28 (cffi:make-pointer 12))
    (grafico:gl-enable-vertex-attrib-array 1)
    malha))
(defun enviar-malha (malha &optional (uso grafico:+gl-dynamic-draw+))
  (setf (malha-quantidade malha) (/ (length *vertices*) 7))
  (grafico:gl-bind-vertex-array (malha-arranjo malha))
  (grafico:gl-bind-buffer grafico:+gl-array-buffer+ (malha-memoria malha))
  (lwlgl.opengl:upload-floats grafico:+gl-array-buffer+ *vertices* uso))
(defun desenhar-malha (malha)
  (grafico:gl-bind-vertex-array (malha-arranjo malha))
  (grafico:gl-draw-arrays grafico:+gl-triangles+ 0 (malha-quantidade malha)))
(defun destruir-malha (malha)
  (lwlgl.opengl:delete-buffer (malha-memoria malha))
  (lwlgl.opengl:delete-vertex-array (malha-arranjo malha)))
(defun localizar-uniforme (programa nome)
  (cffi:with-foreign-string (ponteiro nome) (grafico:gl-get-uniform-location programa ponteiro)))

