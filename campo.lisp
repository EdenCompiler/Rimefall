(defparameter *velocidade-marcha* 2.8)
(defparameter *velocidade-corrida* 4.6)
(defparameter *velocidade-agachado* 1.35)
(defparameter *alcance-passos* 12.0)
(defparameter *alcance-corrida* 24.0)
(defparameter *alcance-agachado* 3.2)
(defparameter *alcance-disparo* 65.0)
(defparameter *alcance-isca* 24.0)
(defparameter *duracao-busca* 7.0)
