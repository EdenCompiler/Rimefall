(defun ativar-botao (sessao identificador janela)
  (case identificador
    ((:fuzil :escopeta :carabina :submetralhadora :precisao :franco-atirador) (when (gethash identificador (sessao-acervo sessao))
                         (setf (notas-arma (sessao-notas sessao)) identificador)))
    ((:silencio :distracao :temporizador :bipé) (when (gethash identificador (sessao-acervo sessao))
                             (setf (notas-preparo (sessao-notas sessao)) identificador)))
    (:nenhum (setf (notas-preparo (sessao-notas sessao)) nil))
    (:diario (setf *edicao-diario* t))
    (:diario-historico (setf *diario-historico* (not *diario-historico*)))
    (:entrar (setf *edicao-diario* nil) (confirmar-notas sessao))
    (:notas (abrir-notas sessao) (setf *foco* :entrar))
    ((:nova :reiniciar) (setf *gravacao-bloqueada* nil *erro-persistencia* nil *mapa-aberto* nil)
     (setf *foco* :entrar *historico-aberto* nil *edicao-diario* nil) (let ((nova (nova-sessao))) (salvar-transicao nova) (return-from ativar-botao nova)))
    (:tentar-salvar
     (setf *gravacao-bloqueada* nil)
     (salvar-transicao sessao))
    (:retomar (unless *gravacao-bloqueada* (setf (sessao-fase sessao) :combate)))
    (:continuar (let ((salva (carregar-sessao))) (when salva (return-from ativar-botao salva))))
    (:configuracoes (setf *configuracoes-abertas* t *foco* :voltar-configuracoes))
    (:voltar-configuracoes (salvar-configuracao) (setf *configuracoes-abertas* nil *remapeando* nil))
    (:mapa (setf *mapa-aberto* t *foco* :fechar-mapa))
    (:fechar-mapa (setf *mapa-aberto* nil *editando-marca* nil))
    (:editar-marca (setf *editando-marca* t))
    (:guardar-marca (when (adicionar-marca sessao (car *celula-mapa*) (cdr *celula-mapa*) *texto-marca*)
                      (setf *editando-marca* nil) (salvar-transicao sessao)))
    (:apagar-marca (adicionar-marca sessao (car *celula-mapa*) (cdr *celula-mapa*) "")
                   (setf *texto-marca* "") (salvar-transicao sessao))
    (:sair (janela:set-window-should-close janela t))
    (:evidencias-anteriores (setf *pagina-evidencias* (max 0 (1- *pagina-evidencias*))))
    (:evidencias-proximas (incf *pagina-evidencias*))
    (:anterior (setf *pagina-evidencias* 0 *pagina-historico* (max 0 (1- *pagina-historico*))))
    (:proxima (setf *pagina-evidencias* 0 *pagina-historico* (min (1- (length (sessao-historico sessao))) (1+ *pagina-historico*))))
    (:fechar-historico (setf *historico-aberto* nil))
    (t (ativar-configuracao identificador janela)))
  sessao)

(defun processar-interface (sessao estado janela)
  (when (entrada:key-pressed-p estado janela:key-escape)
    (cond (*remapeando* (setf *remapeando* nil))
          (*editando-marca* (setf *editando-marca* nil))
          (*configuracoes-abertas* (salvar-configuracao) (setf *configuracoes-abertas* nil))
          (*mapa-aberto* (setf *mapa-aberto* nil))
          (*edicao-diario* (setf *edicao-diario* nil))
          (*historico-aberto* (setf *historico-aberto* nil))
          ((eq (sessao-fase sessao) :pausa) (unless *gravacao-bloqueada* (setf (sessao-fase sessao) :combate)))
          ((eq (sessao-fase sessao) :combate) (setf (sessao-fase sessao) :pausa *foco* :retomar))
          (t (janela:set-window-should-close janela t)))
    (return-from processar-interface sessao))
  (when (processar-edicoes sessao estado janela) (return-from processar-interface sessao))
  (when (and (eq (sessao-fase sessao) :combate) (not (entrada:input-focused-p estado)))
    (setf (sessao-fase sessao) :pausa *foco* :retomar))
  (when (eq (sessao-fase sessao) :combate)
    (let ((soldado (sessao-soldado sessao)))
      (setf (soldado-agachado soldado) (acao-mantida-p estado :agachar)
            (soldado-mirando soldado) (entrada:mouse-down-p estado janela:mouse-button-right)
            (soldado-correndo soldado) (and (acao-mantida-p estado :correr)
                                            (not (soldado-mirando soldado)) (not (soldado-agachado soldado))))
      (multiple-value-bind (dx dy) (entrada:mouse-delta estado)
        (incf (soldado-angulo soldado) (* (getf *configuracao* :sensibilidade) dx))
        (setf (soldado-inclinacao soldado) (limitar (- (soldado-inclinacao soldado) (* (getf *configuracao* :sensibilidade) dy)) -1.3 1.3)))
      (when (entrada:mouse-pressed-p estado janela:mouse-button-left) (disparar sessao))
      (when (acao-pressionada-p estado :recolher) (recolher sessao))
      (when (acao-pressionada-p estado :recarregar) (iniciar-recarga sessao))
      (when (acao-pressionada-p estado :isca) (lancar-isca sessao))
      (when (acao-pressionada-p estado :dispositivo) (colocar-dispositivo sessao))
      (when (acao-pressionada-p estado :apoiar) (apoiar-arma sessao)))
    (return-from processar-interface sessao))
  (when (eq (sessao-fase sessao) :notas)
    (multiple-value-bind (horizontal vertical) (entrada:scroll-delta estado)
      (declare (ignore horizontal))
      (decf *linha-diario* (round (* vertical 3)))))
  (when *edicao-diario*
    (let* ((notas (sessao-notas sessao))
           (digitado (if (and (entrada:key-down-p estado janela:key-left-control)
                              (entrada:key-pressed-p estado janela:key-v))
                         (or (janela:clipboard-string janela) "")
                         (entrada:consume-text-input estado)))
           (texto (concatenate 'string (notas-texto notas) digitado)))
      (when (and (entrada:key-pressed-p estado janela:key-backspace) (plusp (length texto)))
        (setf texto (subseq texto 0 (1- (length texto)))))
      (when (entrada:key-pressed-p estado janela:key-enter) (setf texto (concatenate 'string texto (string #\Newline))))
      (setf (notas-texto notas) (subseq texto 0 (min 600 (length texto))))
      (when (or (plusp (length digitado)) (entrada:key-pressed-p estado janela:key-enter))
        (setf *linha-diario* (max 0 (- (length (linhas-texto (notas-texto notas) 39)) 9)))))
    (unless (entrada:mouse-pressed-p estado janela:mouse-button-left)
      (return-from processar-interface sessao)))
  (when (and (not *configuracoes-abertas*) (not *mapa-aberto*) (not (eq (sessao-fase sessao) :titulo))
             (entrada:key-pressed-p estado janela:key-h))
    (setf *historico-aberto* (not *historico-aberto*) *pagina-historico* 0 *pagina-evidencias* 0 *foco* :fechar-historico))
  (unless *edicao-diario*
    (multiple-value-bind (dx dy) (entrada:mouse-delta estado)
      (when (or (not (zerop dx)) (not (zerop dy)))
        (multiple-value-bind (x y) (entrada:mouse-position estado)
          (multiple-value-bind (largura altura) (janela:window-size janela)
            (setf x (* x (/ 1280 (max largura 1))) y (* y (/ 720 (max altura 1)))))
          (dolist (botao *botoes*)
            (destructuring-bind (identificador bx by largura altura habilitado) botao
              (declare (ignore habilitado))
              (when (and (<= bx x (+ bx largura)) (<= by y (+ by altura))) (setf *foco* identificador))))))))
  (when (entrada:key-pressed-p estado janela:key-tab)
    (let* ((opcoes (mapcar #'first (reverse *botoes*)))
           (indice (position *foco* opcoes)))
      (when opcoes (setf *foco* (nth (mod (1+ (or indice -1)) (length opcoes)) opcoes)))))
  (when (entrada:mouse-pressed-p estado janela:mouse-button-left)
    (multiple-value-bind (x y) (entrada:mouse-position estado)
      (multiple-value-bind (largura altura) (janela:window-size janela)
        (setf x (* x (/ 1280 (max largura 1))) y (* y (/ 720 (max altura 1)))))
      (dolist (botao *botoes*)
        (destructuring-bind (identificador bx by largura altura habilitado) botao
          (when (and habilitado (<= bx x (+ bx largura)) (<= by y (+ by altura)))
            (setf *foco* identificador *edicao-diario* nil)
            (return-from processar-interface (ativar-botao sessao identificador janela)))))))
  (when (entrada:key-pressed-p estado janela:key-enter)
    (when (find-if (lambda (botao) (and (eq (first botao) *foco*) (sixth botao))) *botoes*)
      (setf sessao (ativar-botao sessao *foco* janela))))
  sessao)


(defun acao-mantida-p (estado acao)
  (entrada:key-down-p estado (cdr (assoc acao (getf *configuracao* :atalhos)))))
(defun acao-pressionada-p (estado acao)
  (entrada:key-pressed-p estado (cdr (assoc acao (getf *configuracao* :atalhos)))))
