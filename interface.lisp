(defun desenhar-notas (sessao)
  (cabecalho sessao "01 / NOTAS DE CAMPO")
  (let* ((notas (sessao-notas sessao)) (acervo (sessao-acervo sessao))
         (identidade (nth (min 3 (sessao-usados sessao)) *identidades*)))
    (desenhar-texto (first identidade) 48 208 2 *destaque*)
    (desenhar-texto (second identidade) 48 238 1.4 *apagado*)
    (desenhar-texto "ARMAMENTO / UMA ARMA" 48 277 1.7 *destaque*)
    (loop for chave in '(:fuzil :escopeta :carabina :submetralhadora :precisao :franco-atirador) for y from 310 by 33
          for conhecimento = (procurar-conhecimento chave)
          do (botao chave (conhecimento-titulo conhecimento) 48 y 318
                    :habilitado (gethash chave acervo) :selecionado (eq chave (notas-arma notas)) :altura 29))
    (botao :mapa "MAPA EXPLORADO E MARCAS" 48 515 318)
    (paragrafo "O terreno conhecido é transmitido na morte. Marcas são anotações suas." 58 580 33 *apagado* 1.4 3)
    (desenhar-texto "PREPARO / ESCOLHA ATÉ UM" 398 277 1.7 *destaque*)
    (loop for chave in '(:nenhum :silencio :distracao :temporizador :bipé) for y from 310 by 51
          do (botao chave (if (eq chave :nenhum) "Equipamento básico"
                             (conhecimento-titulo (procurar-conhecimento chave)))
                    398 y 368 :altura 43
                    :habilitado (or (eq chave :nenhum) (gethash chave acervo))
                    :selecionado (if (eq chave :nenhum) (null (notas-preparo notas))
                                     (eq chave (notas-preparo notas)))))
    (let ((conhecimento (procurar-conhecimento (or (and (procurar-conhecimento *foco*) *foco*)
                                                  (notas-preparo notas)))))
      (if conhecimento
        (paragrafo (if (gethash (conhecimento-identificador conhecimento) acervo)
                       (conhecimento-descricao conhecimento) (conhecimento-criterio conhecimento))
                    402 577 40 *apagado* 1.4 3)
        (paragrafo "Duas pedras básicas. Agache para reduzir os passos. Selecione uma descoberta para ler o critério." 402 577 40 *apagado* 1.4 3)))
    (retangulo 800 272 432 315 *painel*)
    (desenhar-texto "DIÁRIO / SEM EFEITO MECÂNICO" 816 290 1.7 *destaque*)
    (botao :diario (if *edicao-diario* "ESCREVENDO / ESC CONCLUI" "EDITAR DIÁRIO") 814 322 404 :altura 40)
    (let ((linhas (linhas-texto (notas-texto notas) 43)))
      (setf *linha-diario* (limitar *linha-diario* 0 (max 0 (- (length linhas) 8))))
      (loop for linha in (nthcdr *linha-diario* linhas) for indice below 8
            do (desenhar-texto linha 816 (+ 385 (* indice 22)) 1.5 *gelo*)))
    (desenhar-texto (format nil "~D / 600   RODA: ROLAR" (length (notas-texto notas))) 816 566 1.3 *apagado*)
    (botao :entrar "ENTRAR EM CAMPO" 800 610 432 :habilitado (not *gravacao-bloqueada*))))

(defun desenhar-relatorio (sessao)
  (let* ((final (member (sessao-fase sessao) '(:vitoria :derrota)))
         (registro (first (sessao-historico sessao)))
         (evidencias (if (eq (sessao-fase sessao) :vitoria)
                         (reverse (soldado-aprendizados (sessao-soldado sessao)))
                         (getf registro :evidencias))))
    (cabecalho sessao (case (sessao-fase sessao)
                       (:vitoria "03 / O POSTO RESISTIU") (:derrota "03 / O ESQUADRÃO CAIU")
                       (t "02 / TRANSMISSÃO PÓSTUMA")))
    (desenhar-texto (case (sessao-fase sessao) (:vitoria "O SILÊNCIO VOLTOU.")
                                          (:derrota "NENHUM SUBSTITUTO.") (t "UM NOME A MENOS.")) 64 230 3 *gelo*)
    (paragrafo (if (eq (sessao-fase sessao) :vitoria)
                  "As três ondas foram eliminadas. Os que ficaram carregam a memória do esquadrão."
                  "O equipamento ficou no campo. O que foi aprendido agora pertence a todos.")
               64 285 63 *apagado* 1.8)
    (retangulo 48 353 1184 219 *painel*)
    (desenhar-texto (if (eq (sessao-fase sessao) :vitoria)
                        "APRENDIZADOS DO SOBREVIVENTE" "CONHECIMENTO TRANSMITIDO") 68 378 2 *destaque*)
    (if evidencias
        (loop for evidencia in evidencias for indice from 0
              do (desenhar-texto (conhecimento-titulo (procurar-conhecimento (evidencia-conhecimento evidencia)))
                                  68 (+ 402 (* indice 14)) 1.7 *gelo*)
                 (desenhar-texto (format nil "VIDA ~D / ~,1F S" (evidencia-soldado evidencia)
                                        (evidencia-instante evidencia)) 910 (+ 402 (* indice 14)) 1.5 *apagado*))
        (desenhar-texto "NENHUMA NOVA EVIDÊNCIA NESTA VIDA." 68 430 1.7 *apagado*))
    (desenhar-texto "H abre o histórico completo com as evidências." 68 549 1.4 *apagado*)
    (botao (if final :reiniciar :notas) (if final "INICIAR NOVA SESSÃO" "PREPARAR PRÓXIMO SOLDADO")
           820 607 412)
    (desenhar-texto (format nil "ONDA ~D / 3    TEMPO EM CAMPO ~D S" (sessao-onda sessao) (floor (sessao-tempo sessao)))
                     64 626 1.7 *apagado*)))

(defun desenhar-historico (sessao)
  (cabecalho sessao "ARQUIVO / MEMÓRIA DO ESQUADRÃO")
  (let* ((registros (reverse (sessao-historico sessao)))
         (quantidade (length registros))
         (registro (nth (min *pagina-historico* (max 0 (1- quantidade))) registros)))
    (desenhar-texto (format nil "VIDAS REGISTRADAS: ~D" quantidade) 64 225 2 *destaque*)
    (if registro
        (if *diario-historico*
            (progn
              (desenhar-texto "DIÁRIO COMPLETO DESTA VIDA" 64 280 2 *destaque*)
              (paragrafo (getf registro :diario) 64 326 105 *gelo* 1.5 13))
        (progn
          (desenhar-texto (format nil "~A / ~D ELIMINAÇÕES / ONDA ~D" (getf registro :nome)
                                  (getf registro :eliminacoes) (getf registro :onda)) 64 269 2 *gelo*)
          (desenhar-texto (getf registro :causa) 64 299 1.3 *apagado*)
          (loop for evidencia in (nthcdr (* 5 *pagina-evidencias*) (getf registro :evidencias)) for indice below 5
                do (desenhar-texto (conhecimento-titulo (procurar-conhecimento (evidencia-conhecimento evidencia)))
                                   64 (+ 320 (* indice 43)) 1.7 *destaque*)
                   (paragrafo (evidencia-descricao evidencia) 64 (+ 341 (* indice 43)) 120 *gelo* 1.3 1))
          (botao :evidencias-anteriores "EVIDÊNCIAS -" 64 549 230 :altura 29 :habilitado (> *pagina-evidencias* 0))
          (botao :evidencias-proximas "EVIDÊNCIAS +" 315 549 230 :altura 29
                 :habilitado (< (* 5 (1+ *pagina-evidencias*)) (length (getf registro :evidencias))))
          (desenhar-texto (getf registro :origem) 64 585 1.4 *apagado*)
          ))
        (paragrafo "Nenhum soldado morreu. Novas descobertas entram no acervo coletivo somente após a morte."
                   64 285 72 *gelo* 2))
    (botao :anterior "ANTERIOR" 48 623 205 :habilitado (> *pagina-historico* 0))
    (botao :proxima "PRÓXIMA" 272 623 205 :habilitado (< *pagina-historico* (1- quantidade)))
    (botao :diario-historico (if *diario-historico* "VER EVIDÊNCIAS" "LER DIÁRIO COMPLETO")
           496 623 360 :habilitado registro)
    (botao :fechar-historico "VOLTAR" 1010 623 222)))

(defun nome-tecla (tecla)
  (case tecla (340 "SHIFT") (341 "CTRL") (32 "ESPAÇO") (t (if (<= 33 tecla 126) (string (code-char tecla)) (format nil "TECLA ~D" tecla)))))
