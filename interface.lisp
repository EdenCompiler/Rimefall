(defparameter *opcoes-configuracao*
  '((:sensibilidade "Sensibilidade" .0005 .008 .0005)
    (:visao "Campo de visão" 55 100 5)
    (:volume "Volume geral" 0.0 1.0 .1)
    (:efeitos "Efeitos" 0.0 1.0 .1)
    (:ambiente "Ambiente" 0.0 1.0 .1)))
(defun identificador-opcao (prefixo chave)
  (intern (concatenate 'string prefixo (symbol-name chave)) :keyword))
(defun desenhar-configuracoes (sessao)
  (cabecalho sessao "PREFERÊNCIAS / CONTROLES E APRESENTAÇÃO")
  (loop for (chave titulo) in *opcoes-configuracao* for y from 226 by 53
        do (desenhar-texto (format nil "~A: ~,3F" titulo (getf *configuracao* chave)) 64 (+ y 15) 1.6 *gelo*)
           (botao (identificador-opcao "MENOS-" chave) "-" 402 y 64 :altura 43)
           (botao (identificador-opcao "MAIS-" chave) "+" 478 y 64 :altura 43))
  (botao :resolucao (format nil "RESOLUÇÃO: ~D X ~D" (getf *configuracao* :largura) (getf *configuracao* :altura)) 64 497 478 :altura 43)
  (botao :tela-cheia (if (getf *configuracao* :tela-cheia) "TELA CHEIA / SIM" "TELA CHEIA / NÃO") 64 548 478 :altura 43)
  (desenhar-texto "TELA CHEIA APLICADA NA PRÓXIMA ABERTURA." 64 610 1.3 *apagado*)
  (loop for par in (getf *configuracao* :atalhos) for indice from 0
        do (botao (identificador-opcao "TECLA-" (car par))
                  (format nil "~A: ~A" (titulo-acao (car par))
                          (if (eq (car par) *remapeando*) "PRESSIONE UMA TECLA" (nome-tecla (cdr par))))
                  606 (+ 217 (* indice 33)) 626 :altura 29))
  (botao :sincronizar (if (getf *configuracao* :sincronizar) "VSYNC / SIM" "VSYNC / NÃO") 606 591 240 :altura 40)
  (botao :neve (format nil "NEVE: ~D" (getf *configuracao* :neve)) 866 591 366 :altura 40)
  (botao :voltar-configuracoes "SALVAR E VOLTAR" 840 644 392 :altura 30))
(defun ativar-configuracao (identificador janela)
  (dolist (opcao *opcoes-configuracao*)
    (destructuring-bind (chave titulo minimo maximo passo) opcao
      (declare (ignore titulo))
      (dolist (direcao '(-1 1))
        (when (eq identificador (identificador-opcao (if (= direcao -1) "MENOS-" "MAIS-") chave))
          (setf (getf *configuracao* chave) (limitar (+ (getf *configuracao* chave) (* direcao passo)) minimo maximo))))))
  (dolist (par *atalhos-padrao*)
    (when (eq identificador (identificador-opcao "TECLA-" (car par))) (setf *remapeando* (car par))))
  (case identificador
    (:resolucao
     (let* ((opcoes '((1280 720) (1600 900) (1920 1080)))
            (indice (position (list (getf *configuracao* :largura) (getf *configuracao* :altura)) opcoes :test #'equal))
            (nova (nth (mod (1+ (or indice 0)) 3) opcoes)))
       (setf (getf *configuracao* :largura) (first nova) (getf *configuracao* :altura) (second nova))
       (janela:set-window-size janela (first nova) (second nova))))
    (:tela-cheia (setf (getf *configuracao* :tela-cheia) (not (getf *configuracao* :tela-cheia))))
    (:sincronizar (setf (getf *configuracao* :sincronizar) (not (getf *configuracao* :sincronizar)))
                 (janela:swap-interval (if (getf *configuracao* :sincronizar) 1 0)))
    (:neve (setf (getf *configuracao* :neve) (mod (+ 85 (getf *configuracao* :neve)) 340)))))

(defun selecionar-celula (sessao coluna linha)
  (setf *celula-mapa* (cons (limitar coluna (- *meia-grade-mapa*) (1- *meia-grade-mapa*)) (limitar linha (- *meia-grade-mapa*) (1- *meia-grade-mapa*)))
        *texto-marca* (or (second (assoc *celula-mapa* (sessao-marcas sessao) :test #'equal)) "")
        *editando-marca* nil))
(defun desenhar-mapa (sessao)
  (cabecalho sessao "CARTOGRAFIA / APENAS MEMÓRIA TRANSMITIDA")
  (retangulo 62 213 452 452 *painel*)
  (loop for coluna from (- *meia-grade-mapa*) below *meia-grade-mapa* do
    (loop for linha from (- *meia-grade-mapa*) below *meia-grade-mapa* for x = (+ 64 (* (+ coluna *meia-grade-mapa*) (/ 448 (* 2 *meia-grade-mapa*)))) for y = (+ 215 (* (+ linha *meia-grade-mapa*) (/ 448 (* 2 *meia-grade-mapa*))))
          for conhecido = (gethash (cons coluna linha) (sessao-explorado sessao))
          do (retangulo x y 10 10 (if conhecido '(.38 .46 .46 1) '(.055 .075 .09 1)))
             (when (and conhecido (assoc (cons coluna linha) (sessao-marcas sessao) :test #'equal))
               (retangulo (+ x 3) (+ y 3) 4 4 *destaque*))
             (when (equal *celula-mapa* (cons coluna linha))
               (retangulo x y 10 2 *gelo*) (retangulo x (+ y 8) 10 2 *gelo*)
               (retangulo x y 2 10 *gelo*) (retangulo (+ x 8) y 2 10 *gelo*))))
  (desenhar-texto "NORTE" 248 199 1.3 *apagado*)
  (desenhar-texto "MARCA MANUAL" 570 223 2 *destaque*)
  (paragrafo "Clique numa célula conhecida ou use as setas. Escreva um rótulo e grave. O mapa não mostra inimigos nem suprimentos automaticamente."
             570 263 64 *apagado* 1.5 4)
  (botao :editar-marca (if *editando-marca* "DIGITANDO / ENTER CONCLUI" "EDITAR RÓTULO") 570 365 650
          :habilitado (gethash *celula-mapa* (sessao-explorado sessao)))
  (paragrafo *texto-marca* 586 434 53 *gelo* 1.8 2)
  (botao :guardar-marca "GRAVAR MARCA" 570 486 310 :habilitado (gethash *celula-mapa* (sessao-explorado sessao)))
  (botao :apagar-marca "APAGAR MARCA" 902 486 318 :habilitado (assoc *celula-mapa* (sessao-marcas sessao) :test #'equal))
  (desenhar-texto (format nil "~D CÉLULAS / ~D MARCAS" (hash-table-count (sessao-explorado sessao))
                                (length (sessao-marcas sessao))) 570 568 1.5 *apagado*)
  (botao :fechar-mapa "VOLTAR ÀS NOTAS" 840 617 392))
(defun processar-edicoes (sessao estado janela)
  (when *remapeando*
    (loop for tecla from 32 to 348
          when (and (not (member tecla '(256 257 258))) (entrada:key-pressed-p estado tecla))
          do (let* ((atalhos (getf *configuracao* :atalhos)) (atual (assoc *remapeando* atalhos))
                    (conflito (find tecla atalhos :key #'cdr)))
               (when conflito (setf (cdr conflito) (cdr atual)))
               (setf (cdr atual) tecla *remapeando* nil)) (return))
    (return-from processar-edicoes t))
  (when *mapa-aberto*
    (when *editando-marca*
      (let ((texto (concatenate 'string *texto-marca*
                    (if (and (entrada:key-down-p estado janela:key-left-control) (entrada:key-pressed-p estado janela:key-v))
                        (or (janela:clipboard-string janela) "") (entrada:consume-text-input estado)))))
        (when (and (entrada:key-pressed-p estado janela:key-backspace) (plusp (length texto)))
          (setf texto (subseq texto 0 (1- (length texto)))))
        (setf *texto-marca* (subseq texto 0 (min 48 (length texto)))))
      (when (entrada:key-pressed-p estado janela:key-enter)
        (adicionar-marca sessao (car *celula-mapa*) (cdr *celula-mapa*) *texto-marca*)
        (salvar-transicao sessao) (setf *editando-marca* nil))
      (return-from processar-edicoes (not (entrada:mouse-pressed-p estado janela:mouse-button-left))))
    (loop for tecla in (list janela:key-left janela:key-right janela:key-up janela:key-down)
          for deslocamento in '((-1 . 0) (1 . 0) (0 . -1) (0 . 1))
          when (entrada:key-pressed-p estado tecla)
          do (selecionar-celula sessao (+ (car *celula-mapa*) (car deslocamento)) (+ (cdr *celula-mapa*) (cdr deslocamento))))
    (when (entrada:mouse-pressed-p estado janela:mouse-button-left)
      (multiple-value-bind (x y) (entrada:mouse-position estado)
        (multiple-value-bind (largura altura) (janela:window-size janela)
          (setf x (* x (/ 1280 largura)) y (* y (/ 720 altura))))
        (when (and (<= 64 x 511) (<= 215 y 662))
          (selecionar-celula sessao (- (floor (- x 64) (/ 448 (* 2 *meia-grade-mapa*))) *meia-grade-mapa*)
                             (- (floor (- y 215) (/ 448 (* 2 *meia-grade-mapa*))) *meia-grade-mapa*))
          (return-from processar-edicoes t)))))
  nil)
(defun desenhar-interface (sessao)
  (cond (*configuracoes-abertas* (desenhar-configuracoes sessao))
        (*mapa-aberto* (desenhar-mapa sessao))
        (*historico-aberto* (desenhar-historico sessao))
        ((eq (sessao-fase sessao) :titulo) (desenhar-titulo sessao))
        ((eq (sessao-fase sessao) :notas) (desenhar-notas sessao))
        ((eq (sessao-fase sessao) :combate) (desenhar-indicadores sessao))
        ((eq (sessao-fase sessao) :pausa) (desenhar-pausa sessao))
        (t (desenhar-relatorio sessao)))
  (when *erro-persistencia*
    (retangulo 48 10 1184 32 '(.2 .035 .025 1))
    (desenhar-texto (subseq *erro-persistencia* 0 (min 110 (length *erro-persistencia*))) 58 20 1.4 *gelo*)
    (unless (eq (sessao-fase sessao) :titulo)
      (botao :tentar-salvar "TENTAR SALVAR" 1030 8 202 :altura 32))))
